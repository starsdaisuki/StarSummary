# StarSummary 环境变量示例 —— 复制为 .env 并填入你的 key：cp .env.example .env

# ── 转录引擎 ──
# 阿里云百炼（默认引擎 qwen3-asr-flash，中文准确率最高；支付宝实名即可，不要外币卡）
# 拿 key：https://bailian.console.aliyun.com → API-KEY
DASHSCOPE_API_KEY=sk-xxx
# Groq（whisper-large-v3，免费额度大、注册不要信用卡；英文够用，中文同音词错误多）
# 拿 key：https://console.groq.com → API Keys
GROQ_API_KEY=gsk_xxx

# ── AI 总结（可选，--summarize 时用）──
DEEPSEEK_API_KEY=sk-xxx

# ── Telegram Bot（仅 bot 模式需要）──
TELEGRAM_BOT_TOKEN=your-bot-token
# 允许使用的 Telegram 用户 ID，逗号分隔；留空则所有人可用
ALLOWED_USERS=

# ── 可选调优 ──
# qwen 引擎的专有名词提示（等价于 --context）。⚠️ 词写不全会把本来对的词带偏，默认留空
STAR_SUMMARY_ASR_CONTEXT=
# qwen 长音频切片目标时长（秒，默认 240；硬上限 280 —— API 单次限 5 分钟）
QWEN_CHUNK_SECONDS=
# qwen 切片并发数（默认 4，纯网络 IO 不吃本地算力）
QWEN_CONCURRENCY=
