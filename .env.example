# StarSummary 环境变量示例 —— 复制为 .env 并填入你的 key：cp .env.example .env

# ── 转录引擎 ──
# Groq（默认引擎，whisper-large-v3，免费额度、注册不要信用卡）
# 拿 key：https://console.groq.com → API Keys
GROQ_API_KEY=gsk_xxx
# 阿里云百炼（paraformer 引擎，超长音频兜底；可选）
DASHSCOPE_API_KEY=sk-xxx

# ── AI 总结（可选，--summarize 时用）──
DEEPSEEK_API_KEY=sk-xxx

# ── Telegram Bot（仅 bot 模式需要）──
TELEGRAM_BOT_TOKEN=your-bot-token
# 允许使用的 Telegram 用户 ID，逗号分隔；留空则所有人可用
ALLOWED_USERS=
